{
  "name": "mci-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Magic Code AI backend (docs/API.md \u0433\u044d\u0440\u044d\u044d\u043d\u0438\u0439 \u0434\u0430\u0433\u0443\u0443)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "postinstall": "prisma generate",
