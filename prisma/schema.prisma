// Magic Code AI өгөгдлийн сангийн схем (PostgreSQL).
// Монгол/англи текст (LocalizedText), зураг (NewsImage) нь Json баганад docs/API.md-ийн хэлбэрээрээ хадгалагдана.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // Vercel: Supabase pooler (6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // migration-д: шууд/session холболт (5432)
}

model Course {
  id          String       @id // "data-analysis" гэх мэт, URL-д ашиглагдана
  category    String // Code | Data | AI | Digital
  status      String // open | waitlist | planned
  price       Int? // төгрөгөөр, батлагдаагүй бол null
  title       Json
  description Json
  image       Json?
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  enrollments Enrollment[]
  publication String @default("published")
  deletedAt DateTime? @map("deleted_at")
  featured Boolean @default(false)
  duration Json?
  level Json?
  managed Boolean @default(false)
  homePresentation Json? @map("home_presentation")

  @@index([category])
  @@map("courses")
}

model News {
  publication String @default("published")
  deletedAt DateTime? @map("deleted_at")
  managed Boolean @default(false)
  id          String    @id
  number      String @default("01") // картан дээрх "01"
  category    Json
  title       Json
  summary     Json
  body        Json?
  details     Json?
  coverImage  Json?     @map("cover_image")
  gallery     Json?
  publishedAt DateTime? @map("published_at")
  isSample    Boolean   @default(false) @map("is_sample")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("news")
}

model Enrollment {
  userId String? @map("user_id")
  adminStatus String @default("new") @map("admin_status")
  deletedAt DateTime? @map("deleted_at")
  id              String    @id // enr_...
  courseId        String    @map("course_id")
  course          Course    @relation(fields: [courseId], references: [id])
  name            String
  email           String
  emailNormalized String    @map("email_normalized") // давхардал шалгахад: жижиг үсгээр
  phone           String
  status          String // pending_payment | waitlisted | paid | cancelled
  createdAt       DateTime  @default(now()) @map("created_at")
  payments        Payment[]

  @@unique([courseId, emailNormalized])
  @@index([createdAt])
  @@map("enrollments")
}

model Profile {
  id String @id
  email String @unique
  name String
  phone String @default("")
  goal String @default("")
  role String @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("profiles")
}

model Order {
  id String @id
  userId String @map("user_id")
  items Json
  status String @default("new")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("orders")
}

model Activity {
  id String @id
  actorId String @map("actor_id")
  action String
  type String
  title Json
  at DateTime @default(now())
  @@index([at])
  @@map("activity")
}

model Payment {
  id           String     @id // pay_...
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  method       String // qpay | bank
  status       String // pending | paid | failed | expired
  amount       Int?
  currency     String     @default("MNT")
  instructions Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  paidAt       DateTime?  @map("paid_at")

  @@index([enrollmentId])
  @@map("payments")
}

// Сайтын сагснаас үүссэн курсын захиалга (frontend docs/COURSE-CHECKOUT.md).
// items: [{ courseId, title: {mn,en}, price }] — үнийг сервер DB-ээс тооцоолно.
model CourseOrder {
  id          String         @id // cord_...
  userId      String         @map("user_id")
  items       Json
  amount      Int? // awaiting_quote үед null
  currency    String         @default("MNT")
  status      String // awaiting_quote | pending_payment | pending_review | paid | cancelled
  reportedAt  DateTime?      @map("reported_at") // хэрэглэгч "шилжүүлсэн" гэж мэдэгдсэн
  paidAt      DateTime?      @map("paid_at")
  paidBy      String?        @map("paid_by") // баталсан админы id
  cancelledAt DateTime?      @map("cancelled_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  access      CourseAccess[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("course_orders")
}

// Хичээл үзэх эрх. Төлбөр батлагдахад (эсвэл Power BI-ийн түр эрх) үүснэ, 3 сарын хугацаатай.
model CourseAccess {
  id            String       @id // acc_...
  userId        String       @map("user_id")
  courseId      String       @map("course_id")
  paymentStatus String       @map("payment_status") // paid | waived
  accessType    String?      @map("access_type") // temporary (Power BI)
  orderId       String?      @map("order_id")
  order         CourseOrder? @relation(fields: [orderId], references: [id])
  grantKey      String       @unique @map("grant_key") // давхардуулахгүй: order:<id>:<course> | waived:<course>:<user>
  activatedAt   DateTime     @map("activated_at")
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([userId, courseId])
  @@map("course_access")
}
