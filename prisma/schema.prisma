// Magic Code AI өгөгдлийн сангийн схем (PostgreSQL).
// Монгол/англи текст (LocalizedText), зураг (NewsImage) нь Json баганад docs/API.md-ийн хэлбэрээрээ хадгалагдана.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // Vercel: Supabase pooler (6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // migration-д: шууд/session холболт (5432)
}

model Course {
  id          String       @id // "data-analysis" гэх мэт, URL-д ашиглагдана
  category    String // Code | Data | AI | Digital
  status      String // open | waitlist | planned
  price       Int? // төгрөгөөр, батлагдаагүй бол null
  title       Json
  description Json
  image       Json?
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  enrollments Enrollment[]
  publication String @default("published")
  deletedAt DateTime? @map("deleted_at")
  featured Boolean @default(false)
  duration Json?
  level Json?
  managed Boolean @default(false)
  homePresentation Json? @map("home_presentation")

  @@index([category])
  @@map("courses")
}

model News {
  publication String @default("published")
  deletedAt DateTime? @map("deleted_at")
  managed Boolean @default(false)
  id          String    @id
  number      String @default("01") // картан дээрх "01"
  category    Json
  title       Json
  summary     Json
  body        Json?
  details     Json?
  coverImage  Json?     @map("cover_image")
  gallery     Json?
  publishedAt DateTime? @map("published_at")
  isSample    Boolean   @default(false) @map("is_sample")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("news")
}

model Enrollment {
  userId String? @map("user_id")
  adminStatus String @default("new") @map("admin_status")
  deletedAt DateTime? @map("deleted_at")
  id              String    @id // enr_...
  courseId        String    @map("course_id")
  course          Course    @relation(fields: [courseId], references: [id])
  name            String
  email           String
  emailNormalized String    @map("email_normalized") // давхардал шалгахад: жижиг үсгээр
  phone           String
  status          String // pending_payment | waitlisted | paid | cancelled
  createdAt       DateTime  @default(now()) @map("created_at")
  payments        Payment[]

  // Unique биш: устгасан (soft delete) бүртгэлтэй хүн дахин бүртгүүлж чадна. Давхардлыг store шалгана.
  @@index([courseId, emailNormalized])
  @@index([createdAt])
  @@map("enrollments")
}

model Profile {
  id String @id
  email String @unique
  name String
  phone String @default("")
  goal String @default("")
  role String @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("profiles")
}

model Order {
  id String @id
  userId String @map("user_id")
  items Json
  status String @default("new")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("orders")
}

model Activity {
  id String @id
  actorId String @map("actor_id")
  action String
  type String
  title Json
  at DateTime @default(now())
  @@index([at])
  @@map("activity")
}

model Payment {
  id           String     @id // pay_...
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  method       String // qpay | bank
  status       String // pending | paid | failed | expired
  amount       Int?
  currency     String     @default("MNT")
  instructions Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  paidAt       DateTime?  @map("paid_at")

  @@index([enrollmentId])
  @@map("payments")
}

// Хүсэлтийн тоо хязгаарлагч. security_limits migration-оор үүссэн.
model RequestLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("request_limits")
}
