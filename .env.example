# Supabase PostgreSQL runtime connection. Use the transaction pooler for Vercel.
DATABASE_URL=
# Direct or session-pooler connection for Prisma migrations.
DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only; never put this in VITE_ variables or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=site-images
# Сайтын хаяг: имэйл баталгаажуулалтын дараах шилжилтэд (анхдагч https://www.mci.mn).
SITE_URL=https://www.mci.mn
PORT=4000
CORS_ORIGINS=https://www.mci.mn,https://mci.mn,http://localhost:5173,http://127.0.0.1:5174
# Optional: allow your Vercel preview domains with an anchored regular expression.
CORS_ORIGIN_REGEX=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_RATE_LIMIT=10
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# QPay: гэрээ хийж түлхүүр авсны дараа бөглөнө. Аль нэг нь хоосон бол сайт "QPay ажиллахгүй" гэж харуулна.
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Backend-ийн нийтэд нээлттэй хаяг, жишээ нь https://dad-back.vercel.app/api/qpay/callback
QPAY_CALLBACK_URL=
# Урт санамсаргүй утга: openssl rand -hex 32
QPAY_CALLBACK_SECRET=

# Cloudflare R2: хичээлийн видео (private bucket). Token: Object Read only, зөвхөн энэ bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mci-videos
