# Локал порт (Vercel дээр хэрэггүй)
PORT=4000

# Frontend-ийн домэйнууд, таслалаар. Хоосон бол зөвхөн localhost:5173 зөвшөөрөгдөнө.
CORS_ORIGINS=https://www.mci.mn,https://mci.mn,http://localhost:5173

# Чатбот (Gemini). Жинхэнэ key-г .env файлд л бичнэ, git-д хэзээ ч commit хийхгүй.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Нэг IP-ээс минутад хэдэн чат хүсэлт зөвшөөрөх
CHAT_RATE_LIMIT=10
