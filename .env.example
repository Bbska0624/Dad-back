# Локал порт (Vercel дээр хэрэггүй)
PORT=4000

# Frontend-ийн домэйнууд, таслалаар. Хоосон бол зөвхөн localhost:5173 зөвшөөрөгдөнө.
CORS_ORIGINS=https://www.mci.mn,https://mci.mn,http://localhost:5173

# PostgreSQL. Локалд хоёулаа ижил. Supabase (Vercel) дээр:
#   DATABASE_URL = transaction pooler (порт 6543, ?pgbouncer=true)
#   DIRECT_URL   = session pooler (порт 5432) — migration-д
DATABASE_URL="postgresql://postgres:НУУЦ_ҮГ@localhost:5432/mci?schema=public"
DIRECT_URL="postgresql://postgres:НУУЦ_ҮГ@localhost:5432/mci?schema=public"

# Чатбот (Gemini). Жинхэнэ key-г .env файлд л бичнэ, git-д хэзээ ч commit хийхгүй.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Нэг IP-ээс минутад хэдэн чат хүсэлт зөвшөөрөх
CHAT_RATE_LIMIT=10

# Банкны шилжүүлгийн заавар (POST /api/payments, method: "bank").
# Аль нэг нь хоосон бол instructions: null буцаана.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
